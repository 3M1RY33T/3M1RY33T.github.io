source "https://rubygems.org"

# Pins Jekyll and its plugin set to exactly what
# actions/jekyll-build-pages@v1 runs in CI. Do not add gems outside the
# github-pages dependency set: the Pages build ignores them, so anything
# extra works locally and fails in production.
gem "github-pages", group: :jekyll_plugins
gem "webrick", "~> 1.8"
